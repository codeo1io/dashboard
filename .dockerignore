# .dockerignore (rm-186, cycle 13) — content landed by reconcile from the
# stranded cycle-10-era PR #97 (branch conductor/run-c2ae28ab9962, where the
# ~340 MB -> ~3 MB context cut was first measured). The image only needs
# manifests, web/, src/, and public/ — the Dockerfile's builder stage COPYs
# web/ and builds it in-image, the final stage copies dist from the builder.
# Excluding everything else keeps .git, node_modules, local secrets, and test
# artifacts from ever reaching the daemon's build context.
.git
.github
.agents
.conductor
.opencode
.slim
docs
node_modules
test
# rm-956 (2026-10-12): the plural dir is NOT matched by `test` above — seal the
# committed Playwright visual baselines (tests/visual, ~212K incl. 3 PNGs) out of
# the daemon build context separately.
tests/
scripts
web/dist
web/dist-fixture
web/coverage
*.md
!README.md
.env*
*.pem
*.key
coverage
.vite
# rm-242 (cycle 1 engine label, 2026-09-25): local test-runner artifacts — test-results/
# and playwright-report/ are created by playwright runs, .pnpm-store/ by pnpm
# store-dir invocations. All are locally generated, large, and never needed
# in the daemon's build context. Unanchored so nested copies (e.g. web/)
# match too.
test-results
playwright-report
.pnpm-store
