# .env.example — dashboard operator/bootstrap template (rm-1984)
#
# Copy to `.env` for local runs ONLY IF your launcher loads it — the server
# itself reads plain environment variables (src/secrets.ts may also read
# `<VAR>_FILE` path indirection for every secret: file wins over the env).
# `.env` is gitignored; never commit real keys.
#
# This file is machine-checked against the README Configuration table by
# test/env-example-sync.test.ts — add a variable in one place, add it in both.
# Markers: [REQUIRED to enable a feature] / [OPTIONAL] / [SENSITIVE].

## Core server
# [OPTIONAL] Bind host. Loopback required for DASHBOARD_DEV_AUTOLOGIN.
DASHBOARD_HOST=0.0.0.0
# [OPTIONAL] Bind port, integer 1-65535.
DASHBOARD_PORT=3000
# [OPTIONAL] Client bundle root served at / (build first: pnpm build:web).
DASHBOARD_WEB_DIST=./web/dist
# [OPTIONAL] Skip the aggregator refresh loop entirely (empty snapshot, no
# GitHub token minting) — fail-closed posture, useful for UI-only dev.
#DASHBOARD_MONITORING_REFRESH=false

## Auth / session
# [SENSITIVE] [REQUIRED in prod] Cookie-signing key: hex or padded base64
# decoding to >=32 bytes, else boot fails (fail-closed).
DASHBOARD_COOKIE_KEY=
# [SENSITIVE] [OPTIONAL] File fallback for the cookie key (default path below).
#DASHBOARD_COOKIE_KEY_FILE=/data/cookie.key
# [OPTIONAL] Single-operator allowlist login (exact, case-insensitive).
DASHBOARD_OPERATOR_LOGIN=
# [SENSITIVE] [OPTIONAL] Comma-separated operator logins the gateway proxy
# accepts; unset = no restriction.
GATEWAY_ALLOWED_OPERATOR_LOGINS=
# [OPTIONAL] Dev/test-only auth bypass — honored only when NODE_ENV is
# development/test AND the bind host is loopback.
#DASHBOARD_DEV_AUTOLOGIN=1

## GitHub data layer (App installation tokens, read-only)
# [SENSITIVE] [REQUIRED to enable the data layer] GitHub App id + private key
# (multiline PEM). When either is unset the layer is disabled and an empty
# snapshot with a warning is served.
DASHBOARD_GITHUB_APP_ID=
DASHBOARD_GITHUB_APP_KEY=
# [SENSITIVE] GitHub OAuth app credentials for the operator sign-in flow.
DASHBOARD_OAUTH_CLIENT_ID=
DASHBOARD_OAUTH_CLIENT_SECRET=
# [OPTIONAL] OAuth callback URI (default fits local dev).
DASHBOARD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

## Gateway operator proxy (/operator/* -> fro-bot/agent)
# [OPTIONAL] Mount the operator UI (exact value 'true' enables; fail-closed).
#DASHBOARD_OPERATOR_UI_ENABLED=true
# [OPTIONAL] Push-notification delivery (exact value 'true').
#DASHBOARD_OPERATOR_PUSH_ENABLED=true
# [OPTIONAL] Gateway-backed operator session forwarding (exact value 'true').
#DASHBOARD_GATEWAY_OPERATOR_SESSION_ENABLED=true
# [OPTIONAL] Pinned trusted origin of the /operator/* proxy target.
#DASHBOARD_GATEWAY_OPERATOR_ORIGIN=https://dashboard.fro.bot
# [REQUIRED when gateway operator-session mode is on] Acknowledge the reverse
# proxy maps /operator/* (incl. the gateway login redirect) onto this origin;
# otherwise the server fails fast at boot.
#DASHBOARD_GATEWAY_PROXY_ACK=same-origin

## Listener message store + webhook ingest
# [OPTIONAL] SQLite file path for the listener store.
DASHBOARD_LISTENER_DB=/data/listener/messages.db
# [SENSITIVE] [REQUIRED to mount the ingest route at all] HMAC key for
# POST /api/listener/ingest; unset = route unmounted (fail-closed).
DASHBOARD_LISTENER_INGEST_KEY=

## Rate limiting (per-path-class; invalid values fall back to defaults)
# [OPTIONAL] Requests per 60s window per client key.
RATE_LIMIT_MAX_PUBLIC=60
RATE_LIMIT_MAX_OPERATOR=60
RATE_LIMIT_MAX_INGEST=60
# [OPTIONAL] Admission cap on distinct rate-limit keys.
RATE_LIMIT_MAX_KEYS=10000
# [OPTIONAL] '1'/'true'/'yes' ONLY when the reverse proxy OVERWRITES
# X-Forwarded-For with the real client; behind an appending proxy, first-hop
# keying is client-spoofable.
#RATE_LIMIT_TRUSTED_PROXY=

## Diagnostics
# [OPTIONAL] Boot-time snapshot cache path (off when unset).
#DASHBOARD_SNAPSHOT_CACHE=
# [OPTIONAL] Operator fixture harness (exact value 'true'; loopback + dev only).
#DASHBOARD_FIXTURE_HARNESS_ENABLED=

## Notes
# - NODE_ENV: standard; 'development'/'test' gates DASHBOARD_DEV_AUTOLOGIN.
# - web/ build-time: VITE_DASHBOARD_VERSION is injected from package.json by
#   vite.config.ts — not an operator variable, do not set it here.
